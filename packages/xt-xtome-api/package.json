{
  "name": "xt-xtome-api",
  "version": "0.1.0",
  "private": true,
  "description": "XTome HTTP API for the library, tags, search, and tag proposals.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:pg --external:fastify --external:@fastify/multipart --external:@fastify/static --external:@aws-sdk/client-s3",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2",
    "pg": "^8.16.0",
    "xt-xtome-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
